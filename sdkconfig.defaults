# MultiDeck, Waveshare ESP32-P4-WIFI6-Touch-LCD-7B. Most of this follows RigDeck's sdkconfig.defaults(.esp32p4).
CONFIG_IDF_TARGET="esp32p4"

# 32 MB flash, RigDeck's layout (see partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# No app rollback in this bootloader. With rollback on, a firmware that never confirms itself
# (most firmware does not) would be thrown out on its second reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# PSRAM: LVGL, the gold logo buffers and the copy buffer live there.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Touch interface: LVGL 9 on the 7 inch display (as RigDeck / Waveshare's examples).
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
# The gold Audiowide logo, drawn from a TTF (main/logo_font.c), exactly as RigDeck's start-up screen.
CONFIG_LV_USE_TINY_TTF=y

# microSD card: long file names ("RigDeck-1.1.6.bin").
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
